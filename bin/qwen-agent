#!/bin/sh
set -eu

SCRIPT=$0
case "$SCRIPT" in
  */*) ;;
  *) SCRIPT=$(command -v -- "$SCRIPT") ;;
esac
while [ -L "$SCRIPT" ]; do
  DIRECTORY=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")" && pwd)
  TARGET=$(readlink "$SCRIPT")
  case "$TARGET" in
    /*) SCRIPT=$TARGET ;;
    *) SCRIPT="$DIRECTORY/$TARGET" ;;
  esac
done

ROOT=$(CDPATH= cd -- "$(dirname -- "$SCRIPT")/.." && pwd)
. "$ROOT/config.sh"

MODE=${QWEN_LOCAL_MODE:-default}
API_BASE_URL="http://$SERVER_HOST:$SERVER_PORT/v1"
MODEL_ALIAS=$SERVER_ALIAS
MODEL_PROFILE=base
SETTINGS_PATH="$ROOT/agent/settings.json"
ACTIVE_ENV_FILE=$ENV_FILE
COMMAND=$(basename -- "$0")
case "$COMMAND" in
  qwen-local-plan) MODE=plan ;;
  qwen-local-incident) MODE=incident ;;
  qwen-local-uncensored)
    MODE=research
    MODEL_ALIAS=$UNCENSORED_SERVER_ALIAS
    MODEL_PROFILE=research
    ;;
  qwen-runpod-uncensored)
    MODE=runpod-research
    MODEL_ALIAS=$UNCENSORED_SERVER_ALIAS
    ;;
  qwen-runpod-unrestricted)
    MODE=runpod-unrestricted
    MODEL_ALIAS=$UNCENSORED_SERVER_ALIAS
    ;;
esac
if [ "$MODE" = research ]; then
  MODEL_ALIAS=$UNCENSORED_SERVER_ALIAS
  MODEL_PROFILE=research
fi
if [ "$MODE" = runpod-research ] || [ "$MODE" = runpod-unrestricted ]; then
  ACTIVE_ENV_FILE="$ROOT/.env.runpod"
  MODEL_ALIAS=$UNCENSORED_SERVER_ALIAS
  SETTINGS_PATH="$ROOT/agent/settings-runpod.json"
fi

if [ ! -f "$ACTIVE_ENV_FILE" ]; then
  if [ "$MODE" = runpod-research ] || [ "$MODE" = runpod-unrestricted ]; then
    printf 'Run make install-runpod-client and bin/configure-runpod before using qwen-runpod-uncensored.\n' >&2
  else
    printf 'Run make install before using qwen-local.\n' >&2
  fi
  exit 1
fi
. "$ACTIVE_ENV_FILE"
: "${LOCAL_QWEN_API_KEY:?LOCAL_QWEN_API_KEY must be set}"

if [ "$MODE" = runpod-research ] || [ "$MODE" = runpod-unrestricted ]; then
  case "${QWEN_RUNPOD_CONTEXT_PROFILE:-128k}" in
    128k) SETTINGS_PATH="$ROOT/agent/settings-runpod.json" ;;
    262k) SETTINGS_PATH="$ROOT/agent/settings-runpod-262k.json" ;;
    1m) SETTINGS_PATH="$ROOT/agent/settings-runpod-1m.json" ;;
    *)
      printf 'QWEN_RUNPOD_CONTEXT_PROFILE must be 128k, 262k, or 1m.\n' >&2
      exit 2
      ;;
  esac
fi

EXTRA_SYSTEM_PROMPT=
if [ -n "${QWEN_EXTRA_SYSTEM_PROMPT_FILE:-}" ]; then
  case "$QWEN_EXTRA_SYSTEM_PROMPT_FILE" in
    /*) ;;
    *)
      printf 'QWEN_EXTRA_SYSTEM_PROMPT_FILE must be an absolute path.\n' >&2
      exit 2
      ;;
  esac
  if [ -L "$QWEN_EXTRA_SYSTEM_PROMPT_FILE" ] || [ ! -f "$QWEN_EXTRA_SYSTEM_PROMPT_FILE" ] || [ ! -r "$QWEN_EXTRA_SYSTEM_PROMPT_FILE" ]; then
    printf 'QWEN_EXTRA_SYSTEM_PROMPT_FILE must be a readable regular file and not a symbolic link.\n' >&2
    exit 2
  fi
  PROMPT_BYTES=$(LC_ALL=C wc -c <"$QWEN_EXTRA_SYSTEM_PROMPT_FILE" | tr -d '[:space:]')
  case "$PROMPT_BYTES" in
    ''|*[!0-9]*)
      printf 'Unable to determine QWEN_EXTRA_SYSTEM_PROMPT_FILE size.\n' >&2
      exit 2
      ;;
  esac
  if [ "$PROMPT_BYTES" -eq 0 ] || [ "$PROMPT_BYTES" -gt 524288 ]; then
    printf 'QWEN_EXTRA_SYSTEM_PROMPT_FILE must contain 1 to 524288 bytes.\n' >&2
    exit 2
  fi
  PROMPT_TEXT_BYTES=$(LC_ALL=C tr -d '\000' <"$QWEN_EXTRA_SYSTEM_PROMPT_FILE" | wc -c | tr -d '[:space:]')
  if [ "$PROMPT_TEXT_BYTES" != "$PROMPT_BYTES" ]; then
    printf 'QWEN_EXTRA_SYSTEM_PROMPT_FILE must not contain NUL bytes.\n' >&2
    exit 2
  fi
  if ! iconv -f UTF-8 -t UTF-8 "$QWEN_EXTRA_SYSTEM_PROMPT_FILE" >/dev/null 2>&1; then
    printf 'QWEN_EXTRA_SYSTEM_PROMPT_FILE must contain valid UTF-8.\n' >&2
    exit 2
  fi
  EXTRA_SYSTEM_PROMPT=$(cat "$QWEN_EXTRA_SYSTEM_PROMPT_FILE")
  if [ -z "$EXTRA_SYSTEM_PROMPT" ]; then
    printf 'QWEN_EXTRA_SYSTEM_PROMPT_FILE must contain text.\n' >&2
    exit 2
  fi
fi

model_available() {
  curl --fail --silent --max-time 2 \
    --header "Authorization: Bearer $LOCAL_QWEN_API_KEY" \
    "http://$SERVER_HOST:$SERVER_PORT/props" >/dev/null &&
  curl --fail --silent --max-time 2 \
    --header "Authorization: Bearer $LOCAL_QWEN_API_KEY" \
    "http://$SERVER_HOST:$SERVER_PORT/v1/models" |
    grep -Fq "\"id\":\"$MODEL_ALIAS\""
}

if [ "$MODE" != runpod-research ] && [ "$MODE" != runpod-unrestricted ] && ! model_available; then
  "$ROOT/bin/start-model" "$MODEL_PROFILE" >/dev/null
fi

SYSTEM_PROMPT=$(cat "$ROOT/agent/system-prompt.md")
case "$MODE" in
  default) ;;
  plan) set -- --approval-mode plan "$@" ;;
  incident)
    SEATBELT_PROFILE=permissive-proxied
    QWEN_SANDBOX_PROXY_COMMAND="exec node '$ROOT/agent/incident-proxy.mjs'"
    API_BASE_URL=http://localhost:8877/v1
    PATH="$ROOT/bin:$PATH"
    unset NO_PROXY no_proxy
    export PATH SEATBELT_PROFILE QWEN_SANDBOX_PROXY_COMMAND
    SYSTEM_PROMPT="$SYSTEM_PROMPT

$(cat "$ROOT/agent/incident-prompt.md")"
    ;;
  research)
    if [ ! -s "$UNCENSORED_MODEL_PATH" ]; then
      printf 'Run make install-uncensored before using the research model.\n' >&2
      exit 1
    fi
    SEATBELT_PROFILE=permissive-proxied
    QWEN_SANDBOX_PROXY_COMMAND="exec node '$ROOT/agent/incident-proxy.mjs'"
    API_BASE_URL=http://localhost:8877/v1
    PATH="$ROOT/bin:$PATH"
    unset NO_PROXY no_proxy
    export PATH SEATBELT_PROFILE QWEN_SANDBOX_PROXY_COMMAND
    SYSTEM_PROMPT="$SYSTEM_PROMPT

$(cat "$ROOT/agent/research-prompt.md")"
    ;;
  runpod-research)
    : "${QWEN_RUNPOD_BASE_URL:?QWEN_RUNPOD_BASE_URL must be set}"
    SEATBELT_PROFILE=permissive-proxied
    QWEN_SANDBOX_PROXY_COMMAND="exec node '$ROOT/agent/runpod-proxy.mjs'"
    API_BASE_URL=http://localhost:8877/v1
    PATH="$ROOT/bin:$PATH"
    unset NO_PROXY no_proxy
    export PATH SEATBELT_PROFILE QWEN_SANDBOX_PROXY_COMMAND QWEN_RUNPOD_BASE_URL
    SYSTEM_PROMPT="$SYSTEM_PROMPT

$(cat "$ROOT/agent/runpod-research-prompt.md")"
    ;;
  runpod-unrestricted)
    : "${QWEN_RUNPOD_BASE_URL:?QWEN_RUNPOD_BASE_URL must be set}"
    API_BASE_URL="$QWEN_RUNPOD_BASE_URL/v1"
    PATH="$ROOT/bin:$PATH"
    unset QWEN_SANDBOX_PROXY_COMMAND SEATBELT_PROFILE
    export PATH QWEN_RUNPOD_BASE_URL
    SYSTEM_PROMPT="$SYSTEM_PROMPT

$(cat "$ROOT/agent/runpod-unrestricted-prompt.md")"
    ;;
  *)
    printf 'Unknown QWEN_LOCAL_MODE: %s\n' "$MODE" >&2
    exit 1
    ;;
esac
if [ -n "$EXTRA_SYSTEM_PROMPT" ]; then
  SYSTEM_PROMPT="$SYSTEM_PROMPT

$EXTRA_SYSTEM_PROMPT"
fi

LOCAL_QWEN_BASE_URL=$API_BASE_URL
OPENAI_API_KEY=$LOCAL_QWEN_API_KEY
OPENAI_BASE_URL=$API_BASE_URL
QWEN_CODE_SYSTEM_SETTINGS_PATH=$SETTINGS_PATH
if [ "$MODE" = runpod-unrestricted ]; then
  QWEN_SANDBOX=false
else
  QWEN_SANDBOX=sandbox-exec
fi
QWEN_USAGE_STATISTICS_ENABLED=false
QWEN_TELEMETRY_ENABLED=false
QWEN_STREAM_IDLE_TIMEOUT_MS=0
OTEL_SDK_DISABLED=true
export LOCAL_QWEN_API_KEY LOCAL_QWEN_BASE_URL OPENAI_API_KEY OPENAI_BASE_URL
export QWEN_CODE_SYSTEM_SETTINGS_PATH QWEN_SANDBOX QWEN_USAGE_STATISTICS_ENABLED
export QWEN_TELEMETRY_ENABLED QWEN_STREAM_IDLE_TIMEOUT_MS OTEL_SDK_DISABLED

exec "$ROOT/node_modules/.bin/qwen" \
  --auth-type openai \
  --model "$MODEL_ALIAS" \
  --openai-base-url "$OPENAI_BASE_URL" \
  --append-system-prompt "$SYSTEM_PROMPT" \
  "$@"
