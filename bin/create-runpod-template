#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

restore_terminal() {
  stty echo 2>/dev/null || true
}

if [ -z "${RUNPOD_API_KEY:-}" ]; then
  trap restore_terminal EXIT HUP INT TERM
  printf 'RunPod account API key: ' >&2
  stty -echo
  IFS= read -r RUNPOD_API_KEY
  stty echo
  printf '\n' >&2
  trap - EXIT HUP INT TERM
fi

if [ -z "$RUNPOD_API_KEY" ]; then
  printf 'RunPod account API key is required.\n' >&2
  exit 2
fi

RESPONSE=$(mktemp)
trap 'rm -f "$RESPONSE"' EXIT HUP INT TERM
curl --fail-with-body --silent --show-error \
  --request POST \
  --url https://rest.runpod.io/v1/templates \
  --header "Authorization: Bearer $RUNPOD_API_KEY" \
  --header 'Content-Type: application/json' \
  --data-binary "@$ROOT/runpod/template.json" \
  --output "$RESPONSE"

if command -v jq >/dev/null 2>&1; then
  jq '{id, name, imageName, ports, volumeInGb, volumeMountPath}' "$RESPONSE"
else
  cat "$RESPONSE"
fi
