#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/config.sh"

[ -f "$ENV_FILE" ]
[ "$(stat -f '%Lp' "$ENV_FILE")" = 600 ]
[ "$(plutil -extract privacy.usageStatisticsEnabled raw "$ROOT/agent/settings.json")" = false ]
[ "$(plutil -extract telemetry.enabled raw "$ROOT/agent/settings.json")" = false ]
[ "$(plutil -extract outboundCorrelation.propagateTraceContext raw "$ROOT/agent/settings.json")" = false ]
for SETTINGS_PATH in "$ROOT/agent/settings-runpod.json" "$ROOT/agent/settings-runpod-262k.json" "$ROOT/agent/settings-runpod-1m.json"; do
  [ "$(plutil -extract privacy.usageStatisticsEnabled raw "$SETTINGS_PATH")" = false ]
  [ "$(plutil -extract telemetry.enabled raw "$SETTINGS_PATH")" = false ]
  [ "$(plutil -extract outboundCorrelation.propagateTraceContext raw "$SETTINGS_PATH")" = false ]
done
grep -q '^QWEN_USAGE_STATISTICS_ENABLED=false$' "$ROOT/bin/qwen-agent"
grep -q '^QWEN_TELEMETRY_ENABLED=false$' "$ROOT/bin/qwen-agent"
grep -q '^QWEN_STREAM_IDLE_TIMEOUT_MS=0$' "$ROOT/bin/qwen-agent"
grep -q '^OTEL_SDK_DISABLED=true$' "$ROOT/bin/qwen-agent"
grep -q 'QWEN_SANDBOX=false' "$ROOT/bin/qwen-agent"
grep -q 'qwen-runpod-unrestricted' "$ROOT/bin/install-agent"
grep -q '127.0.0.1:${WEBUI_PORT:-2501}:8080' "$ROOT/compose.yaml"
grep -q 'ANONYMIZED_TELEMETRY: "false"' "$ROOT/compose.yaml"
grep -q 'OFFLINE_MODE: "true"' "$ROOT/compose.yaml"

if curl --fail --silent --max-time 2 "http://$SERVER_HOST:$SERVER_PORT/health" >/dev/null 2>&1; then
  lsof -nP -iTCP:"$SERVER_PORT" -sTCP:LISTEN | grep -q "127.0.0.1:$SERVER_PORT"
  code=$(curl --silent --output /dev/null --write-out '%{http_code}' \
    --header 'Content-Type: application/json' \
    --data '{"model":"qwen3.8-27b-local","messages":[{"role":"user","content":"test"}],"max_tokens":1}' \
    "http://$SERVER_HOST:$SERVER_PORT/v1/chat/completions")
  [ "$code" = 401 ]
fi

printf 'Security checks passed.\n'
